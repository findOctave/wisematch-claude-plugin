    {
      "name": "render_provider_results",
      "description": "Render the provider-results widget from a search_providers result. Always call search_providers first, then pass its searchId. Optionally pass providerIds to show a subset of that search, in the given order. Do not add provider ids that were not in the search result. Call this once per turn with the final search. Empty results still render the empty widget. This tool only presents cards; it does not search or rank providers. If searchId is expired, call search_providers again",
      "inputSchema": {
        "properties": {
          "searchId": {
            "description": "searchId from the final search_providers result",
            "title": "Searchid",
            "type": "string"
          },
          "providerIds": {
            "anyOf": [
              {
                "items": {
